{
  "manifest_version": 3,
  "name": "PrepMate – Placement Focus Assistant",
  "version": "1.0.0",
  "description": "Stay focused and placement-ready. Pomodoro timer, study statistics, quick notes, and webpage analyzer for college students.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PrepMate – Placement Focus Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
